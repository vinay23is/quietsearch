# =============================================================================
# Quietsearch environment configuration
#
# Copy to .env and fill in real values:   ./scripts/setup.sh   (recommended)
#                                     or:  cp .env.example .env
# .env is git-ignored. Never commit real values.
# =============================================================================

# --- Public identity ------------------------------------------------------------
# Hostname Caddy serves and requests a certificate for.
#   Local development: localhost  (Caddy issues a cert from its own local CA)
#   Server:            search.example.com  (must resolve to the server's IP)
SEARXNG_HOSTNAME=localhost

# Contact address registered with Let's Encrypt (expiry/revocation notices).
# Not used for "localhost".
ACME_EMAIL=you@example.com

# --- Network exposure -----------------------------------------------------------
# Host address the reverse proxy binds to.
#   127.0.0.1 = reachable only from this machine (local development)
#   0.0.0.0   = reachable from the network (server; firewall/security group decides who)
PUBLISH_ADDR=127.0.0.1

# --- Secrets --------------------------------------------------------------------
# Signs SearXNG cookies/tokens. Generate with:  openssl rand -hex 32
SEARXNG_SECRET=

# HTTP basic auth in front of the whole instance.
# Generate the hash with:
#   docker run --rm caddy:2.10-alpine caddy hash-password --plaintext 'your-password'
# Keep the single quotes: bcrypt hashes contain '$', and single quotes stop
# Docker Compose from treating them as variables.
BASIC_AUTH_USER=quiet
BASIC_AUTH_HASH=''

# --- Image versions -------------------------------------------------------------
# Pin SearXNG to a specific tag for reproducible deployments, e.g. 2026.10.1-abcdef123
# (see docs/runbook.md -> "Upgrading"). Tested version shown below.
SEARXNG_VERSION=2026.10.2-19ffbcd30
CADDY_VERSION=2.10-alpine
VALKEY_VERSION=9-alpine
